{
  // 产品编译 → dist/（bin 入口）；moduleResolution node16 以正确解析
  // @modelcontextprotocol/sdk 的 exports 子路径（server/mcp.js 等）。
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
